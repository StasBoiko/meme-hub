# HTTP Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=guestbook_db
DB_SSLMODE=disable

# PostgreSQL Connection String (DATABASE_URL)
DATABASE_URL=postgres://postgres:secret@localhost:5433/guestbook_db?sslmode=disable

# Redis Configuration (REDIS_URL)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Configuration (RABBITMQ_URL)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/callback

# SMTP Configuration (Mailpit for local dev, or Gmail / Brevo / MailerSend for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@guestbook.local
ADMIN_EMAIL=admin@guestbook.local

# Elasticsearch Configuration (ELASTICSEARCH_URL)
ELASTICSEARCH_URL=http://localhost:9200
