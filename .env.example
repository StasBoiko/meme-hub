# HTTP Server Configuration
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=meme_hub_db
DB_SSLMODE=disable

# PostgreSQL Connection String (DATABASE_URL)
DATABASE_URL=postgres://postgres:secret@localhost:5433/meme_hub_db?sslmode=disable

# Redis Configuration (REDIS_URL)
REDIS_URL=redis://localhost:6380/0

# RabbitMQ Configuration (RABBITMQ_URL)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/callback

# SMTP Configuration (Mailpit for local dev, or Gmail / Brevo / MailerSend for production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@meme-hub.local
ADMIN_EMAIL=admin@meme-hub.local

# ZincSearch Configuration (optimized for Render free tier 512MB RAM)
SEARCH_URL=http://localhost:4080
SEARCH_USER=admin
SEARCH_PASSWORD=password
ZINC_FIRST_ADMIN_USER=admin
ZINC_FIRST_ADMIN_PASSWORD=password
# Backward-compatibility fallback
ELASTICSEARCH_URL=http://localhost:4080
